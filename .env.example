# Local development only. Copy this file to .env and never reuse these values in AWS.
APP_ENV=local
CONFIG_SOURCE=env
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info
# Exact origins only; production/staging values come from AWS Parameter Store.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local uses fixture-backed identities. Production/staging must use Cognito via AWS parameters.
AUTH_PROVIDER=local
AUTH_ISSUER=local
AUTH_AUDIENCE=local-dev

POSTGRES_DB=supademo_dev
POSTGRES_USER=supademo
POSTGRES_PASSWORD=supademo_local_postgres_change_me

REDIS_PASSWORD=supademo_local_redis_change_me

DATABASE_URL=postgresql://supademo:supademo_local_postgres_change_me@127.0.0.1:5432/supademo_dev
REDIS_URL=redis://:supademo_local_redis_change_me@127.0.0.1:6379

MINIO_ROOT_USER=supademo
MINIO_ROOT_PASSWORD=supademo_local_minio_change_me

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=supademo-local
AWS_SECRET_ACCESS_KEY=supademo-local-secret

S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET_RAW=supademo-raw
S3_BUCKET_PROCESSED=supademo-processed
S3_BUCKET_PUBLISHED=supademo-published
S3_BUCKET_EXPORTS=supademo-exports
SQS_ENDPOINT=http://127.0.0.1:9324
QUEUE_NAME=demo-jobs
QUEUE_DEAD_LETTER_NAME=dead-letter
QUEUE_VISIBILITY_TIMEOUT_SECONDS=30
QUEUE_MAX_ATTEMPTS=3
QUEUE_POLL_WAIT_SECONDS=5
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=no-reply@supademo.local

# Browser-visible URL only. Never place a secret in NEXT_PUBLIC_* values.
# The local Next.js rewrite proxies this path to the API on port 3001.
NEXT_PUBLIC_API_BASE_URL=/api/backend
